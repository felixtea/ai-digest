        },
        "key_takeaways": {
          "en": [
            "Models were evaluated on 100 tasks from an internal Binary Exploitation benchmark.",
            "GLM-5.3 developed full control flow hijacks in 4% of the trials.",
            "Claude Mythos Preview achieved full control flow hijacks in 6% of the trials."
          ],
          "zh": [
            "模型在包含100项任务的内部二进制利用基准上进行了评估。",
            "GLM-5.3在4%的测试中成功实现了完全的控制流劫持。",
            "Claude Mythos Preview在6%的测试中成功实现了完全的控制流劫持。"
          ]
        },
        "impact": {
