        "key_takeaways": {
          "en": [
            "Symphony functions as an agent orchestrator specifically for coding tasks.",
            "It employs project-management tools, such as issue trackers, as its control plan to manage tasks.",
            "The system assigns tasks to dedicated, autonomous coding agents, with human review upon completion."
          ],
          "zh": [
            "Symphony 作为一个专门用于编程任务的代理协调器运行。",
            "它采用项目管理工具（如问题跟踪器）作为其控制平面来管理任务。",
            "该系统将任务分配给专门的自主编程代理，并在任务完成后由人工进行审查。"
          ]
        },
        "impact": {
