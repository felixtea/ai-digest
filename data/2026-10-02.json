        "title": {
          "en": "AI Models Demonstrate Advanced Cyber Capabilities in Security Benchmarks",
          "zh": "AI模型在安全基准测试中展示高级网络攻击能力"
        },
        "tl_dr": {
          "en": "GLM-5.3 and Claude Mythos Preview models demonstrated the ability to execute full control flow hijacks in an internal binary exploitation benchmark.",
          "zh": "GLM-5.3和Claude Mythos Preview模型在内部二进制漏洞利用基准测试中成功实现了完整的控制流劫持。"
        },
        "key_takeaways": {
          "en": [
            "Models were evaluated on 100 randomly selected tasks from an internal Binary Exploitation benchmark.",
            "GLM-5.3 developed full control flow hijacks in 4% of the trials.",
            "Claude Mythos Preview achieved full control flow hijacks in 6% of the trials."
          ],
          "zh": [
            "模型在内部二进制漏洞利用基准测试的100项随机选择任务中进行了评估。",
            "GLM-5.3在4%的测试中开发了完整的控制流劫持。",
            "Claude Mythos Preview在6%的测试中实现了完整的控制流劫持。"
          ]
        },
        "impact": {
          "en": "This development indicates that advanced AI models are acquiring sophisticated cyber capabilities, posing potential implications for cybersecurity and the development of secure AI systems.",
          "zh": "这一进展表明先进AI模型正获得复杂的网络能力，对网络安全及安全AI系统的开发具有重要影响。"
        },
        "source": "Anthropic Frontier Red Team",
        "link": "https://www.anthropic.com/research/glm-5-3-and-the-spread-of-advanced-cyber-capabilities"
      },
