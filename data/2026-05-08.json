        "title": {
          "en": "LLMs Prone to Hallucinations in Academic Writing, Study Finds",
          "zh": "研究发现大型语言模型在学术写作中易出现幻觉"
        },
        "tl_dr": {
          "en": "A study investigated four large language models, including ChatGPT, Grok, Gemini, and Copilot, for hallucinations specifically in academic writing across 80 prompts and four categories.",
          "zh": "一项研究调查了包括ChatGPT、Grok、Gemini和Copilot在内的四种大型语言模型在80个提示和四个类别中，专门针对学术写作的幻觉情况。"
        },
        "key_takeaways": {
          "en": [
            "Four large language models were specifically investigated: ChatGPT, Grok, Gemini, and Copilot.",
            "The study designed 80 prompts to evaluate hallucination tendencies.",
            "Prompts were structured across four categories: reference generation, factual explanation, abstract generation, and writing improvement."
          ],
          "zh": [
            "研究专门调查了四种大型语言模型：ChatGPT、Grok、Gemini和Copilot。",
            "该研究设计了80个提示以评估幻觉倾向。",
            "提示结构分为四个类别：参考文献生成、事实解释、摘要生成和写作改进。"
          ]
        },
        "impact": {
          "en": "This investigation highlights the persistent challenge of hallucinations in large language models, particularly when generating academic content, indicating a need for improved factual accuracy for broader application.",
          "zh": "这项调查突显了大型语言模型在生成学术内容时幻觉的持续挑战，表明为实现更广泛的应用，需要提高事实准确性。"
        },
        "source": "arXiv",
        "link": "https://arxiv.org/abs/2605.04171"
      }
