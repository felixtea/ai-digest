      {
        "title": {
          "en": "Microsoft Research Develops Vega for Digital Identity",
          "zh": "微软研究院开发Vega数字身份验证系统"
        },
        "tl_dr": {
          "en": "Microsoft Research has developed Vega, a system using zero-knowledge proofs for digital identity that shares only necessary credential information.",
          "zh": "微软研究院开发了Vega系统，该系统利用零知识证明技术处理数字身份，仅分享所需的凭证信息。"
        },
        "key_takeaways": {
          "en": [
            "Vega converts a complete digital credential into a single proof.",
            "It employs zero-knowledge proofs to reveal only required information.",
            "The system is designed for performance compatible with real-world applications."
          ],
          "zh": [
            "Vega将完整的数字凭证转化为单个证明。",
            "它利用零知识证明技术，仅披露所需信息。",
            "该系统设计为具备可在实际应用中运行的性能。"
          ]
        },
        "impact": {
          "en": "This development provides a method for more private and efficient digital identity verification within the AI industry, enabling users to control shared data.",
          "zh": "这项开发为AI时代的数字身份验证提供了一种更私密和高效的方法，使用户能够控制共享数据。"
        },
        "source": "Microsoft Research",
        "link": "https://www.microsoft.com/en-us/research/blog/vega-zero-knowledge-proofs-for-digital-identity-in-the-age-of-ai/"
      }
    ],
